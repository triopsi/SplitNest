# Kopie als .env.production anlegen; diese Datei bleibt außerhalb von Git.
# APP_KEY erzeugen: php artisan key:generate --show
APP_KEY=
APP_URL=https://haushalt.example.org
DB_PASSWORD=
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
SESSION_SECURE_COOKIE=true
# Nur die IP-Adresse(n) eures Reverse-Proxys, durch Komma getrennt.
TRUSTED_PROXIES=
