# Copy this as .env next to your compose file; keep the real .env out of version control.
# Generate the APP_KEY: docker run --rm ghcr.io/triopsi/splitnest:latest php artisan key:generate --show
APP_KEY=
APP_URL=https://haushalt.example.org
DB_PASSWORD=
MARIADB_ROOT_PASSWORD=
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
SESSION_SECURE_COOKIE=true
# Only the IP address(es) of your reverse proxy, comma-separated.
TRUSTED_PROXIES=
# Pin a release version instead of latest, e.g. 1.4.0:
# SPLITNEST_VERSION=
