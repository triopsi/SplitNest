# Environment files and local credentials (keep shareable examples)
.env
.env.*
!.env.example
!.env.*.example
/auth.json

# Dependencies installed from the committed lockfiles
/vendor/
/node_modules/

# Generated frontend and Filament assets
/public/build/
/public/css/filament/
/public/js/filament/
/public/fonts/filament/
/public/fonts-manifest.dev.json
/public/hot
/public/storage

# Laravel runtime data (nested .gitignore files also protect uploads and caches)
/database/*.sqlite*
/storage/*.sqlite*
/storage/*.key
/storage/pail/
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Local backups produced by the README examples and scratch work
/backups/
/work/
/splitnest-backup*.tar.gz
/splitnest-database*.sql
/household-backup*.sql

# Test results and coverage reports
/.phpunit.cache/
/.phpunit.result.cache
/coverage/
/coverage.xml
/junit.xml

# Logs
*.log
npm-debug.log*

# Editor, IDE and local AI-tool settings
/.codex/
/.cursor/
/.idea
/.nova
/.vscode
/.zed
.phpactor.json
*.swp
*.swo
*~

# Generated IDE helpers and local virtual-machine configuration
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
Homestead.json
Homestead.yaml

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
